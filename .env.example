# LLM: claude_subscription (default, uses your local `claude` login) | anthropic_api
FIN_AGENT_LLM=claude_subscription
# FIN_AGENT_MODEL=            # optional; subscription default is the CLI's default model
# ANTHROPIC_API_KEY=          # only for FIN_AGENT_LLM=anthropic_api

# Vault (local clone of MyObsidian) for skill packs and, from step 3, sync-back
VAULT_PATH=C:/Users/<you>/Documents/Repos/MyObsidian

# Data sources
VNSTOCK_SOURCE=VCI            # VCI | TCBS
SEC_USER_AGENT=fin-analyst-agent your-email@example.com
# FIN_AGENT_FIXTURES=tests/fixtures   # force offline synthetic data
