# LLM: claude_subscription (default, uses your local `claude` login) | anthropic_api
FIN_AGENT_LLM=claude_subscription
# FIN_AGENT_MODEL=            # optional; subscription default is the CLI's default model
# ANTHROPIC_API_KEY=          # only for FIN_AGENT_LLM=anthropic_api

# Vault (local clone of MyObsidian) for skill packs and, from step 3, sync-back
VAULT_PATH=C:/Users/<you>/Documents/Repos/MyObsidian

# Data sources
VNSTOCK_SOURCE=VCI            # vnstock 5: VCI | KBS | MAS
# vnstock 5 needs an account to read financial statements (guest tier is refused).
# Key: https://vnstocks.com/account#api-key
VNSTOCK_API_KEY=
SEC_USER_AGENT=fin-analyst-agent your-email@example.com
# FIN_AGENT_FIXTURES=tests/fixtures   # force offline synthetic data

# Vault knowledge base (GraphRAG): python -m fin_agent.knowledge index
# FIN_AGENT_KB=auto                       # auto (use when indexed) | off
# FIN_AGENT_EMBEDDINGS=hf:intfloat/multilingual-e5-small   # or ollama:<model>; changing it re-embeds
# FIN_AGENT_KB_DIR=data/knowledge
# FIN_AGENT_KB_INCLUDE=Intelligence/Investment_Analysis,Domains/Financial_Engineering,Projects/FinAnalystAgent/Learnings

# Agent evaluation with TypeSafe Jev (python -m fin_agent.evals). Key: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0          # pin a version when tuning thresholds; default jev-latest
